# Server Configuration
PORT=5050

# Database Configuration (MongoDB connection URI)
# NOTE: Production multi-document transaction safety (blood stock & request fulfillment)
# REQUIRES a MongoDB Replica Set (e.g. MongoDB Atlas cluster or self-hosted replica set) or Sharded Cluster.
# Standalone MongoDB instances do not support multi-document ACID transactions and will fail closed in production.
database_url=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/namma_blood?retryWrites=true&w=majority

# Security & Encryption
PASSWORD_ENCRYPT_LEVEL=12
CREATEHASH_KEY=sha256
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=1d

# Email Service (Nodemailer - Gmail or SMTP provider)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
